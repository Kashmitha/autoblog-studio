{
  "name": "@autoblog/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.json && concurrently -n compile,api \"tsc -w -p tsconfig.json --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "worker:dev": "node --watch dist/worker.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node ../scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --config jest.config.cjs",
    "test:integration": "jest --runInBand --config jest.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "google-auth-library": "^11.3.3",
    "googleapis": "^189.0.0",
    "helmet": "^8.1.0",
    "htmlparser2": "^12.0.0",
    "ioredis": "^5.8.2",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.9",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
