generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum ArticleStatus {
  PLANNED
  RESEARCHING
  DRAFTING
  NEEDS_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  REJECTED
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  @@index([expiresAt])
}
model Article {
  id String @id @default(cuid())
  title String
  slug String @unique
  niche String @default("DevOps")
  intent String @default("")
  backlogPriority Int @default(0)
  planningNotes String @default("")
  planningVersion Int @default(1)
  excerpt String @default("")
  html String @default("")
  labels String[] @default([])
  status ArticleStatus @default(PLANNED)
  version Int @default(1)
  aiAssisted Boolean @default(false)
  disclosure Boolean @default(false)
  generation Json @default("{}")
  approvedAt DateTime?
  scheduledAt DateTime?
  publishedAt DateTime?
  publishedUrl String?
  canonicalUrl String?
  remotePostId String? @unique
  remoteBlogId String?
  publishingTarget String @default("local")
  remoteStatus String?
  remoteSyncedAt DateTime?
  remoteSyncError String?
  draftAttemptedAt DateTime?
  updateReminderAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources Source[]
  media ArticleMedia[]
  reports QualityReport[]
  jobs PublishJob[]
  events ArticleEvent[]
  inspections IndexInspection[]
  diagnostics FetchDiagnostic[]
  @@index([status, scheduledAt])
  @@index([updatedAt])
}
model Source {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url String
  title String
  checkedAt DateTime?
  httpStatus Int?
  note String @default("")
  @@unique([articleId, url])
}
model MediaAsset {
  id String @id @default(cuid())
  title String
  url String
  alt String
  creator String
  sourceUrl String
  profileUrl String?
  provider String
  license String
  licenseUrl String
  attribution String
  rightsConfirmed Boolean @default(false)
  checkedAt DateTime @default(now())
  metadata Json @default("{}")
  articles ArticleMedia[]
  createdAt DateTime @default(now())
}
model ArticleMedia {
  articleId String
  mediaId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([articleId, mediaId])
}
model QualityReport {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version Int
  passed Boolean
  score Int
  issues Json
  createdAt DateTime @default(now())
  @@index([articleId, createdAt])
}
model ArticleEvent {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  from ArticleStatus
  to ArticleStatus
  reason String
  createdAt DateTime @default(now())
  @@index([articleId, createdAt])
}
model PublishJob {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  key String @unique
  mode String @default("mock")
  target String @default("local")
  liveTest Boolean @default(false)
  blogId String?
  state String @default("PENDING")
  attempts Int @default(0)
  scheduledAt DateTime
  startedAt DateTime?
  finishedAt DateTime?
  error String?
  createdAt DateTime @default(now())
  @@index([state, scheduledAt])
}
model Integration {
  provider String @id
  encryptedTokens String
  accountLabel String @default("")
  blogId String?
  blogUrl String?
  firstLiveTestAuthorizedAt DateTime?
  liveTestSucceededAt DateTime?
  updatedAt DateTime @updatedAt
}
model OAuthState {
  id String @id
  sessionId String
  verifier String
  expiresAt DateTime
}
model AutomationSettings {
  id String @id @default("owner")
  paused Boolean @default(true)
  emergencyStop Boolean @default(false)
  dailyLimit Int @default(2)
  times String[] @default(["09:00", "17:00"])
  timezone String @default("Asia/Colombo")
  sitemapUrl String?
  sitemapCheckedAt DateTime?
  sitemapValid Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model FinanceEntry {
  id String @id @default(cuid())
  date DateTime @db.Date
  kind String
  category String
  amount Decimal @db.Decimal(14, 6)
  currency String @default("USD")
  source String
  reference String @unique
  note String @default("")
  createdAt DateTime @default(now())
  @@index([date, kind])
}
model TrafficMetric {
  id String @id @default(cuid())
  date DateTime @db.Date
  url String @default("")
  pageviews Int?
  impressions Int?
  clicks Int?
  source String
  createdAt DateTime @default(now())
  @@unique([date, url, source])
  @@index([date])
}
model AiUsage {
  id String @id @default(cuid())
  model String
  state String @default("RESERVED")
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  reservedUsd Decimal @db.Decimal(14, 6)
  costUsd Decimal? @db.Decimal(14, 6)
  error String?
  createdAt DateTime @default(now())
  @@index([createdAt, state])
}
model AuditLog {
  id String @id @default(cuid())
  action String
  entityId String?
  message String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model WorkerHeartbeat {
  id String @id
  lastSeen DateTime @default(now())
}
model ReportingSettings {
  id String @id @default("owner")
  searchConsoleSiteUrl String?
  propertyVerifiedAt DateTime?
  updatedAt DateTime @updatedAt
}
model TrafficSync {
  id String @id @default(cuid())
  siteUrl String
  trigger String
  state String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  imported Int @default(0)
  errorCode String?
  errorMessage String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  @@index([siteUrl, startedAt])
}
model IndexInspection {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  siteUrl String
  inspectionUrl String
  state String
  verdict String?
  coverageState String?
  robotsTxtState String?
  indexingState String?
  pageFetchState String?
  lastCrawlTime DateTime?
  crawledAs String?
  googleCanonical String?
  userCanonical String?
  sitemaps String[] @default([])
  referringUrls String[] @default([])
  inspectionResultLink String?
  errorCode String?
  errorMessage String?
  checkedAt DateTime @default(now())
  @@index([articleId, siteUrl, inspectionUrl, checkedAt])
}
model FetchDiagnostic {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url String
  state String
  result Json?
  errorMessage String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  @@index([articleId, url, startedAt])
}
