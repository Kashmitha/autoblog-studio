NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3100
DATABASE_URL=postgresql://autoblog:autoblog_local_only@localhost:15432/autoblog?schema=public
REDIS_URL=redis://localhost:56379
POSTGRES_USER=autoblog
POSTGRES_PASSWORD=autoblog_local_only
POSTGRES_DB=autoblog
# Generated locally by npm run setup. Never publish these values.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
OWNER_EMAIL=kashmitha@localhost
OWNER_PASSWORD=
BLOGGER_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3100/api/integrations/google/callback
AI_ENABLED=false
# openai or groq. Groq credentials are never sent to OpenAI.
AI_PROVIDER=openai
AI_BILLING_AUTHORIZED=false
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Set to free only while your own Groq account is on the Free plan.
# Studio cannot verify billing plan; upgrading the account may incur charges.
GROQ_PLAN=free
GROQ_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# For Groq start with 4000 output tokens (includes reasoning); quota may limit requests.
AI_MAX_OUTPUT_TOKENS=2400
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_MONTHLY_LIMIT_USD=3
AI_DAILY_GENERATION_LIMIT=2
QUALITY_MIN_WORDS=180
QUALITY_SOURCE_MAX_AGE_DAYS=30
UNSPLASH_ACCESS_KEY=
SEARCH_CONSOLE_SITE_URL=
GA_PROPERTY_ID=
ADSTERRA_API_KEY=
